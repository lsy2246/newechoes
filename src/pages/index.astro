---
import Layout from "@/components/layout/Layout.astro";
import HomeDiorama from "@/components/home/HomeDiorama.astro";
import type {
  HomeStoryScene,
  HomeStorySceneElement,
  HomeStorySceneElementKind,
} from "@/components/home/homeStoryTypes.ts";

export const prerender = true;

const rect = (
  desktop: readonly [number, number, number, number],
  mobile: readonly [number, number, number, number],
) => ({
  desktop: {
    x: desktop[0],
    y: desktop[1],
    width: desktop[2],
    height: desktop[3],
  },
  mobile: {
    x: mobile[0],
    y: mobile[1],
    width: mobile[2],
    height: mobile[3],
  },
}) satisfies HomeStorySceneElement["bounds"];

const element = (
  id: string,
  kind: HomeStorySceneElementKind,
  bounds: HomeStorySceneElement["bounds"],
  options: Pick<HomeStorySceneElement, "role" | "motionText" | "priority"> = {},
): HomeStorySceneElement => ({ id, kind, bounds, ...options });

const homeContent = {
  // 首页首屏的大标题，只影响首页动画里的标题显示
  screenTitle: "lsy",
  // 第一幕：输入素材卡片
  sources: {
    heading: "input / things I keep returning to",
    subheading: "cinema · travel · books · code · AI · writing",
    cards: [
      { title: "cinema log", note: "A slower way to see the world" },
      { title: "travel journal", note: "Distance turns into inner weather" },
      { title: "code sketches", note: "Thoughts that learn to move" },
      { title: "AI playground", note: "A mirror for unfinished questions" },
      { title: "reading list", note: "Other minds left open on the desk" },
      { title: "writing archive", note: "Loose days becoming a shape" },
    ],
  },
  // 第二幕：三条内容分流
  lanes: {
    heading: "classify / three inner lanes",
    subheading: "seeing · making · thinking",
    items: [
      {
        label: "seeing",
        title: "cinema / travel",
        note: "Images, places, and the way memory edits them",
      },
      {
        label: "making",
        title: "code / AI",
        note: "Tools, systems, and strange new working habits",
      },
      {
        label: "thinking",
        title: "books / writing",
        note: "Borrowed thoughts becoming my own language",
      },
    ],
  },
  // 第三幕：项目/作品展示
  projects: {
    heading: "work / systems I shaped",
    subheading: "Ideas becoming products, agents, and infrastructure",
    items: [
      {
        label: "agent system",
        title: "Ennoia",
        note: "A light core for agents, memory, and permissioned tools",
        details: ["agent scheduling", "memory and tool boundaries"],
      },
      {
        label: "model gateway",
        title: "API Worker",
        note: "A resilient bridge across models, streams, and fallbacks",
        details: ["model routing", "stream fallback paths"],
      },
      {
        label: "production AI platform",
        title: "AI Platform",
        note: "Gateways, business systems, and cloud delivery built for production scale",
        details: ["multi-protocol AI gateway", "reconciliation, migration, and GitOps"],
      },
    ],
  },
  // 最后一幕：当前状态卡片
  current: {
    role: "AI platform & full-stack engineer",
    stack: "Go · React · Rust · Kubernetes",
    summary:
      "Building reliable AI gateways, agent systems, and cloud-native products.",
    status: "shipping · measuring · refining",
    contact: "lsy22@vip.qq.com",
    panels: [
      {
        tag: "BUILD",
        title: "AI gateways · Agent systems · cloud platforms",
        note: "Production systems for models, data, and operations",
      },
      {
        tag: "WRITE",
        title: "blog.lsy22.com",
        note: "Notes, essays, and unfinished questions",
      },
      {
        tag: "LIVE",
        title: "cinema · travel · books",
        note: "A life kept close to perception",
      },
    ],
  },
} as const;

const homeStoryScenes = [
  {
    id: "input",
    tags: ["layer", "view", "reveal"],
    snapshotProgress: 0.36,
    canonicalWeight: 0.36,
    transitionWeight: 0.24,
    transitionMode: "scan",
    elements: [
      element("chapter-heading", "heading", rect([0.17, 0.18, 0.66, 0.08], [0.08, 0.12, 0.84, 0.08]), { priority: 1 }),
      element("chapter-statement", "statement", rect([0.17, 0.27, 0.66, 0.1], [0.08, 0.22, 0.84, 0.12]), { priority: 1 }),
      element("theme-1", "material", rect([0.12, 0.43, 0.22, 0.25], [0.1, 0.39, 0.8, 0.13]), { role: "track-1", motionText: "signal" }),
      element("theme-2", "material", rect([0.39, 0.39, 0.22, 0.29], [0.1, 0.54, 0.8, 0.13]), { role: "track-2", motionText: "route" }),
      element("theme-3", "material", rect([0.66, 0.43, 0.22, 0.25], [0.1, 0.69, 0.8, 0.13]), { role: "track-3", motionText: "group" }),
    ],
  },
  {
    id: "classify",
    tags: ["parallel", "protocol", "text"],
    snapshotProgress: 0.57,
    canonicalWeight: 0.02,
    transitionWeight: 0.31,
    elements: [
      element("chapter-heading", "heading", rect([0.17, 0.18, 0.66, 0.08], [0.08, 0.1, 0.84, 0.08]), { priority: 1 }),
      element("chapter-statement", "statement", rect([0.17, 0.27, 0.66, 0.1], [0.08, 0.2, 0.84, 0.12]), { priority: 1 }),
      element("theme-1", "lane", rect([0.17, 0.43, 0.2, 0.27], [0.09, 0.38, 0.82, 0.15]), { role: "track-1", motionText: homeContent.lanes.items[0].label }),
      element("theme-2", "lane", rect([0.4, 0.43, 0.2, 0.27], [0.09, 0.55, 0.82, 0.15]), { role: "track-2", motionText: homeContent.lanes.items[1].label }),
      element("theme-3", "lane", rect([0.63, 0.43, 0.2, 0.27], [0.09, 0.72, 0.82, 0.15]), { role: "track-3", motionText: homeContent.lanes.items[2].label }),
    ],
  },
  {
    id: "work",
    tags: ["code", "writing", "network", "migrate"],
    snapshotProgress: 0.78,
    canonicalWeight: 0.04,
    transitionWeight: 0.025,
    elements: [
      element("chapter-heading", "heading", rect([0.17, 0.18, 0.66, 0.08], [0.08, 0.1, 0.84, 0.08]), { priority: 1 }),
      element("chapter-statement", "statement", rect([0.17, 0.27, 0.66, 0.1], [0.08, 0.2, 0.84, 0.12]), { priority: 1 }),
      element("project-1", "project", rect([0.17, 0.43, 0.2, 0.29], [0.09, 0.36, 0.82, 0.16]), { role: "track-1", motionText: homeContent.projects.items[0].label, priority: 0.9 }),
      element("project-2", "project", rect([0.4, 0.4, 0.2, 0.32], [0.09, 0.54, 0.82, 0.16]), { role: "track-2", motionText: homeContent.projects.items[1].label, priority: 1 }),
      element("project-3", "project", rect([0.63, 0.43, 0.2, 0.29], [0.09, 0.72, 0.82, 0.16]), { role: "track-3", motionText: homeContent.projects.items[2].label, priority: 0.9 }),
    ],
  },
  {
    id: "today",
    tags: ["assemble", "emergence"],
    snapshotProgress: 1,
    canonicalWeight: 0.005,
    transitionWeight: 0,
    elements: [
      element("chapter-heading", "heading", rect([0.19, 0.15, 0.3, 0.06], [0.1, 0.1, 0.8, 0.06]), { priority: 1 }),
      element("chapter-statement", "statement", rect([0.19, 0.23, 0.48, 0.12], [0.1, 0.18, 0.8, 0.16]), { priority: 1 }),
      element("project-1", "project", rect([0.19, 0.43, 0.19, 0.22], [0.1, 0.4, 0.8, 0.13]), { role: "track-1", motionText: "trace", priority: 0.9 }),
      element("project-2", "project", rect([0.405, 0.43, 0.19, 0.22], [0.1, 0.55, 0.8, 0.13]), { role: "track-2", motionText: "tool", priority: 1 }),
      element("project-3", "project", rect([0.62, 0.43, 0.19, 0.22], [0.1, 0.7, 0.8, 0.13]), { role: "track-3", motionText: "platform", priority: 0.9 }),
      element("current-status", "status", rect([0.19, 0.73, 0.36, 0.05], [0.1, 0.86, 0.48, 0.05]), { motionText: "ongoing" }),
      element("current-contact", "contact", rect([0.6, 0.73, 0.21, 0.05], [0.6, 0.86, 0.3, 0.05]), { motionText: "today" }),
    ],
  },
] as const satisfies readonly HomeStoryScene[];
---

<Layout
  contentLayout="custom"
  hideFooter={true}
  headerMode="overlay"
>
  <HomeDiorama content={homeContent} storyScenes={homeStoryScenes} />
</Layout>
